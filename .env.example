# ==========================================
# Video Template Extractor Configuration
# ==========================================

# Server binding
PORT=8000
HOST=0.0.0.0

# Canonical domain for SEO & sitemaps (e.g. https://yourdomain.com)
CANONICAL_URL=https://vtpl.app

# Google AdSense Publisher ID (e.g. ca-pub-1234567890123456)
# Leave blank to show neat placeholder slots
AD_CLIENT_ID=

# Whisper model for speech/subtitles ("small", "tiny", or "base")
# Use "tiny" for lower memory/faster CPU speed
VTPL_WHISPER_MODEL=small

# Maximum upload video file size in Megabytes
MAX_UPLOAD_MB=100

# Concurrency limit for parallel video analyses
MAX_CONCURRENT_JOBS=2

# Directory where caches and templates are stored
VTPL_WORK_DIR=work
